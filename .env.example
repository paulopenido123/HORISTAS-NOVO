# WhatsApp Cloud API (Meta) — pegue no Meta for Developers > seu app > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=escolha_uma_string_secreta_qualquer
WHATSAPP_API_VERSION=v21.0

# Claude API — console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI API (GPT-5.6) — provedor usado por padrão no serviço PAGO de
# assistente de IA pros médicos clientes (decidido com o Paulo em
# 03/09/2026). Pegue a chave em https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Modelo padrão pra quase tudo (secretaria, WhatsApp, agenda, financeiro,
# recibos, perguntas gerais) — o mais barato da família (Luna). Confira o
# nome/preço atual em https://platform.openai.com/docs/models antes de
# ativar pra valer.
OPENAI_MODEL=gpt-5.6-luna
# Modelo mais forte (mais caro), usado só pra análise de prontuário/exame
# mais complexa — quando a camada de segurança acha um alerta crítico, ou
# a IA precisa buscar evidência no PubMed. Ver seção "roteamento por
# complexidade".
OPENAI_MODEL_PRONTUARIO_COMPLEXO=gpt-5.6-sol

# Gemini API (Google) — opção alternativa, não usada por padrão desde a
# virada pra OpenAI (03/09/2026). Só precisa preencher se quiser trocar
# algum módulo de volta pra Gemini. Pegue a chave em
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_PRONTUARIO_COMPLEXO=gemini-3.5-flash
CLAUDE_MODEL_PRONTUARIO_COMPLEXO=claude-sonnet-4-6

# Qual provedor cada módulo de IA usa: 'openai', 'claude' ou 'gemini'.
# Padrão: 'openai' em todos — configure OPENAI_API_KEY acima antes de usar
# de verdade. Só troque pra 'claude'/'gemini' se preferir outro provedor
# nesse módulo específico (aí configure a chave correspondente).
IA_PROVEDOR_SECRETARIA=openai
IA_PROVEDOR_PRONTUARIO=openai
IA_PROVEDOR_FINANCEIRO=openai

# --- Calculador de uso de IA (cobrança do serviço de assistente pros médicos) ---
# O preço de cada modelo (GPT-5.6 Luna/Sol, Gemini Flash-Lite, Claude
# Sonnet etc.) já vem numa tabela dentro do código
# (app/services/ia_uso_service.py, PRECOS_USD_POR_1K) — as linhas abaixo
# são só um preço GENÉRICO de reserva, usado apenas se você configurar um
# modelo novo que ainda não está nessa tabela. Confira sempre o preço
# oficial antes de cobrar de verdade: OpenAI em
# https://platform.openai.com/docs/models, Gemini em
# https://ai.google.dev/gemini-api/docs/pricing, Claude em
# https://platform.claude.com/docs/en/about-claude/pricing
OPENAI_PRECO_ENTRADA_POR_1K_USD=0.00020
OPENAI_PRECO_SAIDA_POR_1K_USD=0.00120
GEMINI_PRECO_ENTRADA_POR_1K_USD=0.00030
GEMINI_PRECO_SAIDA_POR_1K_USD=0.00250
CLAUDE_PRECO_ENTRADA_POR_1K_USD=0.00300
CLAUDE_PRECO_SAIDA_POR_1K_USD=0.01500
# Cotação do dólar em reais — o Gemini/Claude cobram em dólar, então é essa
# cotação que converte o custo real pra reais. Não precisa ser em tempo
# real, mas reveja de vez em quando (conferido em 03/09/2026: ~R$ 5,16).
USD_PARA_BRL=5.16
# Margem cobrada em cima do custo real (5.0 = cobra 5x o custo real da IA)
IA_MARGEM_PADRAO=5.0
# Crédito único de boas-vindas no primeiro acesso do médico, em R$
IA_CREDITO_BOAS_VINDAS=5.00
# Dias de teste grátis, por módulo, a partir do primeiro uso daquele módulo
IA_DIAS_TRIAL_MODULO=30
# Preço fixo cobrado por cada confirmação de consulta enviada ao paciente
# (WhatsApp/e-mail) depois de esgotados os 10 envios grátis e o trial de 30 dias
IA_PRECO_ENVIO_PACIENTE=1.50
# Preço fixo cobrado por cada emissão de recibo (Módulo 4) depois de
# esgotado o trial de 30 dias do módulo financeiro
IA_PRECO_EMISSAO_RECIBO=2.00

# Banco de dados — Neon (migrado do Supabase em 10/09/2026)
# Cole aqui a "Connection string" que aparece no seu projeto Neon
# (Neon Console > seu projeto > Connect), algo como:
#   postgresql://usuario:senha@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Neon Object Storage — fotos dos consultórios (substitui o Supabase
# Storage). Veja em Neon Console > seu projeto > Object Storage:
#   NEON_S3_ENDPOINT_URL: o "S3 endpoint" mostrado lá (começa com https://)
#   NEON_S3_REGION: a região do seu projeto (ex: us-east-2)
#   NEON_S3_ACCESS_KEY_ID / NEON_S3_SECRET_ACCESS_KEY: crie em
#     Neon Console > seu projeto > Object Storage > Credentials
#   NEON_S3_BUCKET: o nome que você deu ao bucket ao criar (sugestão
#     usada neste projeto: lifemax-reserva-horas, com visibilidade Public)
NEON_S3_ENDPOINT_URL=
NEON_S3_REGION=us-east-2
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=
NEON_S3_BUCKET=lifemax-reserva-horas

# Email (notifica funcionários quando um médico escolhe um turno)
# Para Gmail: gere uma "senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Asaas (PIX) — para os médicos comprarem créditos
# Pegue a chave em asaas.com > Configurações > Integrações > Chave de API
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Emissão de Nota Fiscal (NFS-e) — certificado digital A1 da PRÓPRIA
# LIFEMAX, usado para emitir a nota cobrada de cada médico pelo aluguel
# do consultório/sala (botão "Emitir NF" em Relatórios > Transações ainda
# não faturadas). Sem essas 3 variáveis preenchidas, o botão mostra um
# aviso claro em vez de tentar emitir (veja app/services/nfe_service.py).
NFE_A1_CERTIFICADO_PATH=
NFE_A1_SENHA=
NFE_CNPJ_EMISSOR=

# Painel administrativo
ADMIN_PASSWORD=
ADMIN_PHONE=
ADMIN_PHONE_PATRICIA=
FLASK_SECRET_KEY=

# Rede Lifemax -- link "Peça avaliações" do seu perfil do Google Meu
# Negócio (ex: https://g.page/r/SEU-CODIGO/review), pro botão
# "Avalie-nos também no Google". Sem preencher, o botão não aparece.
GOOGLE_REVIEW_URL=

# Segurança (prontuário/exames)
ENCRYPTION_KEY=
FORCE_HTTPS_COOKIES=false

# Google Agenda (integração)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/google/callback

# Login do médico com conta Google (reaproveita o Client ID/Secret acima)
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5000/login/google/callback

# Google Sheets — planilha de médicos (Módulo 2)
GOOGLE_SERVICE_ACCOUNT_JSON=
PLANILHA_MEDICOS_ID=

# Matriz de agendamento admin: não exige nova variável.
